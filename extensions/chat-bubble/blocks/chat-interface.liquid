{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

{% liquid
  assign welcome_message = block.settings.welcome_message | strip

  # If the setting value is a translation token like "t:chat.welcomeDefault",
  # resolve it via the translation filter so the shopper never sees the token.
  if welcome_message contains 't:'
    assign welcome_key = welcome_message | remove: 't:' | strip
    assign translated_welcome = welcome_key | t

    # Theme apps can sometimes surface "translation missing: ..." strings.
    # If that happens, fall back to our default welcome message key.
    if translated_welcome contains 'translation missing'
      assign welcome_message = 'chat.welcomeDefault' | t
    else
      assign welcome_message = translated_welcome
    endif
  endif
%}

<div
  class="shop-ai-chat-container"
  style="
    --shop-ai-accent-color: {{ block.settings.chat_bubble_color }};
    --shop-ai-user-message-color: {{ block.settings.user_message_color }};
    --shop-ai-add-to-cart-color: {{ block.settings.add_to_cart_button_color }};
    --shop-ai-link-and-price-color: {{ block.settings.link_and_price_color }};
  "
>
  <div class="shop-ai-chat-bubble">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </div>

  <div class="shop-ai-chat-window">
    <div class="shop-ai-chat-header">
      <div>{{ 'chat.title' | t }}</div>
      <button class="shop-ai-chat-close">✕</button>
    </div>

    <div class="shop-ai-chat-messages">
      <!-- Messages will be added here by JavaScript -->
    </div>

    <div class="shop-ai-chat-input">
      <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
      <button class="shop-ai-chat-send">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: {{ welcome_message | json }},
    debug: {{ block.settings.debug_logging | json }},
    i18n: {
      welcomeDefault: {{ 'chat.welcomeDefault' | t | json }},
      loadingHistory: {{ 'chat.loadingHistory' | t | json }},
      errorGeneric: {{ 'chat.errorGeneric' | t | json }},
      errorBusy: {{ 'chat.errorBusy' | t | json }},
      checkoutLinkText: {{ 'chat.checkoutLinkText' | t | json }},
      allowPopups: {{ 'chat.allowPopups' | t | json }},
      authInProgress: {{ 'chat.authInProgress' | t | json }},
      authSuccessContinue: {{ 'chat.authSuccessContinue' | t | json }},
      productTopMatching: {{ 'chat.productTopMatching' | t | json }},
      productNoneFound: {{ 'chat.productNoneFound' | t | json }},
      productSelectionMessage: {{ 'chat.productSelectionMessage' | t | json }},
      productSelectionOutOfRange: {{ 'chat.productSelectionOutOfRange' | t | json }},
      productSelectionOutOfRangeDynamic: {{ 'chat.productSelectionOutOfRangeDynamic' | t | json }},
      addToCart: {{ 'chat.addToCart' | t | json }},
      addToCartPrompt: {{ 'chat.addToCartPrompt' | t | json }},
      addingToCart: {{ 'chat.addingToCart' | t | json }},
      addedToCart: {{ 'chat.addedToCart' | t | json }},
      addedToCartMessage: {{ 'chat.addedToCartMessage' | t | json }},
      addToCartFailed: {{ 'chat.addToCartFailed' | t | json }},
      cartSummaryHeader: {{ 'chat.cartSummaryHeader' | t | json }},
      cartEmpty: {{ 'chat.cartEmpty' | t | json }},
      viewCartLinkText: {{ 'chat.viewCartLinkText' | t | json }},
      cartItemsCountLabel: {{ 'chat.cartItemsCountLabel' | t | json }},
      cartSubtotalLabel: {{ 'chat.cartSubtotalLabel' | t | json }},
      cartFetchFailed: {{ 'chat.cartFetchFailed' | t | json }}
    }
  };
  window.shopId = {{ shop.id }};
</script>

{% schema %}
{
  "name": "t:chat.schema.blockName",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "t:chat.schema.settings.chatBubbleColor",
      "default": "#5046e4"
    },
    {
      "type": "color",
      "id": "user_message_color",
      "label": "t:chat.schema.settings.userMessageColor",
      "default": "#5046e4"
    },
    {
      "type": "color",
      "id": "add_to_cart_button_color",
      "label": "t:chat.schema.settings.addToCartButtonColor",
      "default": "#5046e4"
    },
    {
      "type": "color",
      "id": "link_and_price_color",
      "label": "t:chat.schema.settings.linkAndPriceColor",
      "default": "#5046e4"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "t:chat.schema.settings.welcomeMessage",
      "default": "t:chat.welcomeDefault"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "t:chat.schema.settings.systemPrompt",
      "options": [
        {
          "value": "standardAssistant",
          "label": "t:chat.schema.settings.standardAssistant"
        },
        {
          "value": "enthusiasticAssistant",
          "label": "t:chat.schema.settings.enthusiasticAssistant"
        }
      ],
      "default": "standardAssistant"
    },
    {
      "type": "checkbox",
      "id": "debug_logging",
      "label": "t:chat.schema.settings.debugLogging",
      "default": false
    }
  ]
}
{% endschema %}
